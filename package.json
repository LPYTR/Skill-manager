{
  "name": "local-skill-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "bin": { "skill-manager": "dist/cli.js" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "tsx src/cli.ts ui --no-open",
    "cli": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json --noEmit",
    "build": "tsc && vite build",
    "test": "pnpm build && tsx --test --test-concurrency=1 tests/*.test.ts",
    "ui": "node dist/cli.js ui",
    "setup:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup.ps1"
  },
  "dependencies": {
    "@fastify/static": "^8.2.0",
    "commander": "^14.0.0",
    "fastify": "^5.6.0",
    "lucide-react": "^0.468.0",
    "proper-lockfile": "^4.1.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.8.1",
    "yauzl": "^3.2.0",
    "yazl": "^3.3.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^3.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
